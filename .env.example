# Скопируй этот файл в .env в корне репозитория перед первым запуском
# приложения или тестов — app.config читает переменные оттуда (см.
# Settings.model_config в backend/app/config.py). DATABASE_URL и APP_SECRET
# обязательны и не имеют значения по умолчанию: без .env запуск честно упадёт
# с ошибкой pydantic вместо того, чтобы тихо уйти на посторонний сервер.
#
# Тесты НЕ используют базу из DATABASE_URL напрямую. tests/conftest.py
# выводит из неё адрес базы «<имя>_test» (например, для flowline — это
# flowline_test) и только по ней делает drop_all/create_all. Эту базу
# нужно создать отдельно один раз, например:
#   docker compose exec db createdb -U flowline flowline_test
#
# Этот адрес — для запуска С ХОСТА (тесты, локальный uvicorn вне контейнера):
# Postgres публикуется наружу через DB_PORT, поэтому здесь localhost.
# Контейнер api под docker-compose получает СВОЙ собственный DATABASE_URL —
# он задан прямо в docker-compose.yml (сервис db, порт 5432 внутри сети
# compose) и переопределяет значение из этого файла. Не пытайся унифицировать
# оба адреса в одну переменную: у хоста и у контейнера api разное понятие
# «localhost», и один адрес не может быть верным для обоих одновременно.
DATABASE_URL=postgresql+psycopg://flowline:flowline@localhost:5432/flowline
APP_SECRET=change-me-to-a-long-random-string
# Порт, на котором Postgres публикуется на хост, и он же используется в
# DATABASE_URL выше. Переопредели оба вместе, если 5432 занят. К адресу
# контейнера api (docker-compose.yml, порт 5432 внутри сети compose) отношения
# не имеет.
DB_PORT=5432
# Учётные данные сервиса db (docker-compose.yml). Обязательно смени на боевой
# установке и держи в синхроне с DATABASE_URL выше.
POSTGRES_USER=flowline
POSTGRES_PASSWORD=flowline
POSTGRES_DB=flowline
PUBLIC_BASE_URL=https://flowline.example.com
DEFAULT_LOCALE=az
SUPPORTED_LOCALES=az,en,ru
SIGNUP_MODE=open
MAIL_TRANSPORT=none
