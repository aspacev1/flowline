# Снаружи сайт виден на 80/443 — их публикует Docker на хосте (см.
# docker-compose.yml, сервис web), пробрасывая на высокие порты ниже.
# Caddy сам на 80/443 сесть не может и не должен: внутри контейнера он
# работает не от root и без единой capability (USER web, cap_drop: ALL).
# Явное указание нужно, иначе Caddy решит, что снаружи он и есть 8080/8443,
# и получит ACME-проверку домена и редирект с http на https не по тем портам.
{
	http_port 8080
	https_port 8443
}

pm.datanova.az {
	encode gzip

	# Заголовки безопасности — на каждый ответ, и статику, и API.
	header {
		# Браузеру запрещается угадывать тип файла: угаданный «HTML» в
		# загруженном пользователем содержимом — это XSS на ровном месте.
		X-Content-Type-Options nosniff
		# Страницу нельзя показывать во фрейме чужого сайта: защита от
		# clickjacking. Двумя заголовками: CSP — для современных браузеров,
		# X-Frame-Options — для тех, кто CSP не читает.
		X-Frame-Options DENY
		# Адреса проектов не должны уезжать в Referer на чужие сайты по
		# ссылкам из комментариев: слаг — часть секретной публичной ссылки.
		Referrer-Policy strict-origin-when-cross-origin
		# Скрипты и запросы — только со своего домена. style-src с
		# 'unsafe-inline' сознательно: интерфейс раскладывает диаграмму
		# инлайновыми стилями (ширины полосок), и без него Гант слеп.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# HSTS действует только по HTTPS; на голом HTTP браузер его
		# игнорирует, так что отдавать его безусловно безопасно.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Версию сервера наружу не объявляем.
		-Server
	}

	# API разбирается раньше файлов. Порядок здесь не косметический: ниже
	# стоит фолбэк на index.html, и он поймал бы /api/несуществующее первым,
	# отдав клиенту HTML вместо ответа сервера.
	handle /api/* {
		# X-Forwarded-For переписывается настоящим адресом клиента, а не
		# дополняется: пришедшее снаружи значение — это строка от кого
		# угодно, а по этому заголовку приложение считает пределы частоты
		# входа и гостевых комментариев. Оставить чужое значение — значит
		# позволить обходить предел сменой заголовка.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Маршруты живут на клиенте, а файлов под них нет: без фолбэка
		# перезагрузка страницы на /projects даёт 404 от Caddy, хотя внутри
		# приложения такой адрес существует.
		try_files {path} /index.html
		file_server
	}
}
